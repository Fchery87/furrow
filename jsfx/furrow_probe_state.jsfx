desc: Furrow probe state
tags: utility
in_pin: none
out_pin: none

options: gmem=FurrowProbeState

@init
// gmem[0] version, gmem[1] serialize reads, gmem[2] heartbeat, gmem[3] runtime token,
// gmem[4] token of the instance that last read. Per value i: gmem[100 + i] decoded value,
// gmem[200 + i] exact match, gmem[1000 + 4 * i + w] stored words.
// gmem[300] raw value read back, gmem[301] exact match. Seed k: gmem[400 + k] and gmem[410 + k].
VERSION = 1;
VALUE_COUNT = 8;
values = 0;
values[0] = 0;
values[1] = -0;
values[2] = -16.25;
values[3] = 1 / 3;
values[4] = 288000 + 1 / 3;
values[5] = -(2 ^ 30) - 1 / 7;
values[6] = 2 ^ 52 + 2;
values[7] = 2 ^ -30;
RAW = 1 / 3;
SEED_COUNT = 3;
seeds = 100;
seeds[0] = 0;
seeds[1] = 16777215;
seeds[2] = 16777217;
token = floor(time_precise() * 1000003) % 16777215 + 1;
gmem[0] = VERSION;
gmem[3] = token;
heartbeat = 0;

// Splits a finite double into four 16-bit words, least significant first, by exact arithmetic.
// EEL2 == has a tolerance, so every exact test uses ===.
function encode(x) local(a, e, biased, mant, sign, m) (
  x === 0 ? (
    w0 = 0; w1 = 0; w2 = 0; w3 = 0;
  ) : (
    sign = x < 0;
    a = abs(x);
    e = floor(log(a) / log(2));
    a / 2 ^ e >= 2 ? e += 1;
    a / 2 ^ e < 1 ? e -= 1;
    e < -1022 ? (
      biased = 0;
      mant = a / 2 ^ -1074;
    ) : (
      biased = e + 1023;
      mant = (a / 2 ^ e - 1) * 2 ^ 52;
    );
    m = mant;
    w0 = m - floor(m / 65536) * 65536;
    m = floor(m / 65536);
    w1 = m - floor(m / 65536) * 65536;
    m = floor(m / 65536);
    w2 = m - floor(m / 65536) * 65536;
    m = floor(m / 65536);
    w3 = m + biased * 16 + sign * 32768;
  );
);

function decode(a0, a1, a2, a3) local(top, biased, sign, mant, a) (
  top = floor(a3 / 16);
  biased = top - floor(top / 2048) * 2048;
  sign = floor(a3 / 32768);
  mant = (((a3 - top * 16) * 65536 + a2) * 65536 + a1) * 65536 + a0;
  a = biased === 0 ? mant * 2 ^ -1074 : (1 + mant / 2 ^ 52) * 2 ^ (biased - 1023);
  sign ? -a : a;
);

@block
heartbeat += 1;
gmem[2] = heartbeat;

@serialize
reading = file_avail(0) >= 0;
format = 1;
file_var(0, format);
format === 1 ? (
  i = 0;
  loop(VALUE_COUNT,
    !reading ? encode(values[i]);
    file_var(0, w0);
    file_var(0, w1);
    file_var(0, w2);
    file_var(0, w3);
    reading ? (
      decoded = decode(w0, w1, w2, w3);
      gmem[100 + i] = decoded;
      gmem[200 + i] = decoded === values[i];
      gmem[1000 + 4 * i] = w0;
      gmem[1001 + 4 * i] = w1;
      gmem[1002 + 4 * i] = w2;
      gmem[1003 + 4 * i] = w3;
    );
    i += 1;
  );
  raw = RAW;
  file_var(0, raw);
  reading ? (
    gmem[300] = raw;
    gmem[301] = raw === RAW;
  );
  k = 0;
  loop(SEED_COUNT,
    seed = seeds[k];
    file_var(0, seed);
    reading ? (
      gmem[400 + k] = seed;
      gmem[410 + k] = seed === seeds[k];
    );
    k += 1;
  );
  reading ? (
    gmem[4] = token;
    gmem[1] += 1;
  );
);
