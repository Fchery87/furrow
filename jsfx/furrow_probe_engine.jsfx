desc: Furrow probe engine
tags: instrument midi
in_pin: none
out_pin: none

options: maxmem=8388608 gmem=FurrowProbeEngine

slider1:1<0,1,1>Pattern on
slider2:0<0,16777215,1>-State revision

@init
ext_midi_bus = 1;
ext_noinit = 1;
LANES = 4;
STEPS = 16;
step_beats = 0.25;
gate_beats = step_beats * 0.5;
// About 0.02 samples at 120 BPM and 44.1 kHz. The probe log records beat_position to check this holds.
RAMP_FIT_BEATS = 0.000001;
// Sixty-four steps, sixteen per lane. A zero entry does not sound.
// The bits match probes/pattern-4x16.txt. Lane notes are 36, 38, 42, 46.
step_on = 0;
memset(step_on, 0, 64);
step_on[0] = 1;
step_on[4] = 1;
step_on[8] = 1;
step_on[12] = 1;
step_on[18] = 1;
step_on[22] = 1;
step_on[26] = 1;
step_on[30] = 1;
step_on[32] = 1;
step_on[34] = 1;
step_on[36] = 1;
step_on[38] = 1;
step_on[40] = 1;
step_on[42] = 1;
step_on[44] = 1;
step_on[46] = 1;
step_on[52] = 1;
step_on[60] = 1;
step_on[63] = 1;
note_of = 100;
note_of[0] = 36;
note_of[1] = 38;
note_of[2] = 42;
note_of[3] = 46;
// Beat of each lane's pending note-off, or -1 when the lane holds no note.
release_at = 200;
memset(release_at, -1, LANES);
next_step = 0;
was_playing = 0;
block_end_beat = 0;
prev_tempo = -1;
slope = 0;
// gmem mailbox version 1, one engine per REAPER instance.
// gmem[1] heartbeat. Lua writes gmem[3] op, gmem[4] step and gmem[5] delay in blocks, then gmem[2] sequence.
// gmem[9] set to 1 asks the engine to bump slider2 itself when it applies the command.
// The engine writes gmem[6] acknowledged sequence, gmem[7] state revision and gmem[8] restore count.
// gmem[100 + step] mirrors each step.
MAILBOX_VERSION = 1;
OP_TOGGLE = 1;
MIRROR = 100;
// gmem[10] counts @serialize writes and gmem[11] startup releases. gmem[12] is 1 in an
// engine that releases every lane on its first block.
// A held note is lost from memory when the engine reloads, so the first block releases
// every lane's note and sends All Notes Off on its channel.
startup_release = 1;
gmem[12] = 1;
// A command written before this instance loaded is not replayed.
last_seq = gmem[2];
pending_seq = last_seq;
apply_at = 0;

// Inverts beats = (tempo * x + slope * x^2 / 2) / (60 * srate) for the sample offset x.
function offset_of(beat) local(beats, root, x) (
  beats = beat - beat_position;
  root = tempo * tempo + 2 * slope * 60 * srate * beats;
  x = root > 0 ? 120 * srate * beats / (tempo + sqrt(root)) : 60 * srate * beats / tempo;
  x = floor(x + 0.5);
  max(0, min(samplesblock - 1, x));
);

function send_off(lane, offset) (
  midi_bus = 0;
  midisend(offset, $x80 + lane, note_of[lane], 0);
  release_at[lane] = -1;
);

function release_all() local(lane) (
  lane = 0;
  loop(LANES,
    release_at[lane] >= 0 ? send_off(lane, 0);
    lane += 1;
  );
);

// Sends due note-offs in beat order. Inclusive puts a release at the limit before a hit there.
function flush_releases(limit, inclusive) local(lane, best, best_beat, due) (
  best = 0;
  while (best >= 0) (
    best = -1;
    lane = 0;
    loop(LANES,
      due = inclusive ? release_at[lane] <= limit : release_at[lane] < limit;
      release_at[lane] >= 0 && due && (best < 0 || release_at[lane] < best_beat) ? (
        best = lane;
        best_beat = release_at[lane];
      );
      lane += 1;
    );
    best >= 0 ? send_off(best, offset_of(best_beat));
  );
);

@block
gmem[0] = MAILBOX_VERSION;
gmem[1] += 1;
startup_release ? (
  lane = 0;
  loop(LANES,
    midi_bus = 0;
    midisend(0, $x80 + lane, note_of[lane], 0);
    midisend(0, $xB0 + lane, 123, 0);
    release_at[lane] = -1;
    lane += 1;
  );
  startup_release = 0;
  gmem[11] += 1;
);
seq = gmem[2];
seq != last_seq ? (
  seq != pending_seq ? (
    pending_seq = seq;
    apply_at = gmem[1] + gmem[5];
  );
  gmem[1] >= apply_at ? (
    step = floor(gmem[4]);
    gmem[3] == OP_TOGGLE && step >= 0 && step < LANES * STEPS ? step_on[step] = !step_on[step];
    gmem[9] == 1 ? (
      slider2 += 1;
      sliderchange(slider2);
    );
    last_seq = seq;
    gmem[6] = seq;
    gmem[7] += 1;
  );
);
mirror_step = 0;
loop(LANES * STEPS,
  gmem[MIRROR + mirror_step] = step_on[mirror_step];
  mirror_step += 1;
);

playing = slider1 >= 0.5 && (play_state == 1 || play_state == 5);
!playing ? (
  was_playing ? release_all();
  was_playing = 0;
  prev_tempo = -1;
) : (
  // A tempo change inside the last block moves this block's start by less than that block's beats.
  // A seek or loop wrap that moves less than one block is treated as continuous playback.
  jumped = !was_playing || abs(beat_position - block_end_beat) > block_beats;
  jumped ? (
    release_all();
    next_step = ceil(beat_position / step_beats - 0.000001);
  );
  // REAPER 7.82 reports tempo once per block, at its first sample, and ramps linearly in time.
  // Continue the last block's tempo change only if that block advanced exactly as a ramp would.
  // A tempo step or a ramp edge inside it fails that test, and this block holds its tempo.
  slope = 0;
  !jumped && prev_tempo >= 0 ? (
    ramp_beats = (prev_tempo + tempo) * prev_block / (120 * srate);
    abs(beat_position - prev_beat - ramp_beats) < RAMP_FIT_BEATS ? slope = (tempo - prev_tempo) / prev_block;
  );
  prev_tempo = tempo;
  prev_beat = beat_position;
  prev_block = samplesblock;
  was_playing = 1;
  block_beats = (tempo * samplesblock + slope * samplesblock * samplesblock / 2) / (60 * srate);
  block_end_beat = beat_position + block_beats;
  while (next_step < STEPS && next_step * step_beats < block_end_beat) (
    hit = next_step * step_beats;
    flush_releases(hit, 1);
    lane = 0;
    loop(LANES,
      step_on[lane * STEPS + next_step] ? (
        release_at[lane] >= 0 ? send_off(lane, offset_of(hit));
        midi_bus = 0;
        midisend(offset_of(hit), $x90 + lane, note_of[lane], 100);
        release_at[lane] = hit + gate_beats;
      );
      lane += 1;
    );
    next_step += 1;
  );
  flush_releases(block_end_beat, 0);
);

@serialize
// Format 1 is a version word, then the 64 step words.
reading = file_avail(0) >= 0;
format = 1;
file_var(0, format);
format == 1 ? file_mem(0, step_on, LANES * STEPS);
reading ? (
  gmem[7] += 1;
  gmem[8] += 1;
) : gmem[10] += 1;
