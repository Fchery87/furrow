desc: Furrow probe engine
tags: instrument midi
in_pin: none
out_pin: none

options: maxmem=8388608

slider1:1<0,1,1>Pattern on

@init
ext_midi_bus = 1;
ext_noinit = 1;
LANES = 4;
STEPS = 16;
step_beats = 0.25;
gate_beats = step_beats * 0.5;
// A gap above this is a seek or loop wrap. Block-tempo drift during a ramp stays far below it.
JUMP_BEATS = 0.01;
// Sixty-four steps, sixteen per lane. A zero entry does not sound.
// The bits match probes/pattern-4x16.txt. Lane notes are 36, 38, 42, 46.
step_on = 0;
memset(step_on, 0, 64);
step_on[0] = 1;
step_on[4] = 1;
step_on[8] = 1;
step_on[12] = 1;
step_on[18] = 1;
step_on[22] = 1;
step_on[26] = 1;
step_on[30] = 1;
step_on[32] = 1;
step_on[34] = 1;
step_on[36] = 1;
step_on[38] = 1;
step_on[40] = 1;
step_on[42] = 1;
step_on[44] = 1;
step_on[46] = 1;
step_on[52] = 1;
step_on[60] = 1;
step_on[63] = 1;
note_of = 100;
note_of[0] = 36;
note_of[1] = 38;
note_of[2] = 42;
note_of[3] = 46;
// Beat of each lane's pending note-off, or -1 when the lane holds no note.
release_at = 200;
memset(release_at, -1, LANES);
next_step = 0;
was_playing = 0;
block_end_beat = 0;

function offset_of(beat) local(x) (
  x = floor((beat - beat_position) * samplesblock / block_beats + 0.5);
  max(0, min(samplesblock - 1, x));
);

function send_off(lane, offset) (
  midi_bus = 0;
  midisend(offset, $x80 + lane, note_of[lane], 0);
  release_at[lane] = -1;
);

function release_all() local(lane) (
  lane = 0;
  loop(LANES,
    release_at[lane] >= 0 ? send_off(lane, 0);
    lane += 1;
  );
);

// Sends due note-offs in beat order. Inclusive puts a release at the limit before a hit there.
function flush_releases(limit, inclusive) local(lane, best, best_beat, due) (
  best = 0;
  while (best >= 0) (
    best = -1;
    lane = 0;
    loop(LANES,
      due = inclusive ? release_at[lane] <= limit : release_at[lane] < limit;
      release_at[lane] >= 0 && due && (best < 0 || release_at[lane] < best_beat) ? (
        best = lane;
        best_beat = release_at[lane];
      );
      lane += 1;
    );
    best >= 0 ? send_off(best, offset_of(best_beat));
  );
);

@block
// This probe reads tempo once per block. It does not follow a ramp inside the block.
playing = slider1 >= 0.5 && (play_state == 1 || play_state == 5);
block_beats = samplesblock * tempo / (60 * srate);
!playing ? (
  was_playing ? release_all();
  was_playing = 0;
) : (
  !was_playing || abs(beat_position - block_end_beat) > JUMP_BEATS ? (
    release_all();
    next_step = ceil(beat_position / step_beats - 0.000001);
  );
  was_playing = 1;
  block_end_beat = beat_position + block_beats;
  while (next_step < STEPS && next_step * step_beats < block_end_beat) (
    hit = next_step * step_beats;
    flush_releases(hit, 1);
    lane = 0;
    loop(LANES,
      step_on[lane * STEPS + next_step] ? (
        release_at[lane] >= 0 ? send_off(lane, offset_of(hit));
        midi_bus = 0;
        midisend(offset_of(hit), $x90 + lane, note_of[lane], 100);
        release_at[lane] = hit + gate_beats;
      );
      lane += 1;
    );
    next_step += 1;
  );
  flush_releases(block_end_beat, 0);
);
